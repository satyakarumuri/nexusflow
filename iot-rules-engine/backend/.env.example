PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/iot_rules
CORS_ORIGIN=http://localhost:5173

# Optional: require this key (header x-api-key) on POST /api/telemetry
INGEST_API_KEY=

# Time-series retention (days) for raw telemetry
TELEMETRY_RETENTION_DAYS=30

# Ingestion buffer: flush when N readings queued or every X ms
INGEST_BATCH_SIZE=500
INGEST_FLUSH_MS=500

# Devices unseen for this many seconds are marked offline
OFFLINE_AFTER_SECONDS=30

# Optional MQTT ingestion (topic payload = same JSON as POST /api/telemetry)
MQTT_URL=
MQTT_TOPIC=iot/telemetry

# Optional comma-separated allow-list of webhook hostnames (empty = allow all)
WEBHOOK_ALLOWED_HOSTS=

# Insert example rules on first start when the rules collection is empty
SEED_DEFAULT_RULES=true
